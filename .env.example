# Vercel Storage (Neon Postgres): injected automatically when the store is connected to the project
DATABASE_URL=
# Vercel Blob (either of these; newer stores provide BLOB_STORE_ID and use OIDC)
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Random 32+ char secret: openssl rand -base64 48
AUTH_SECRET=
# Used only by scripts/seed-admin.ts: "email:password,email2:password2"
ADMIN_SEED=
# Contact form (Resend)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://tromsologopedene.no
